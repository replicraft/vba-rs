' INV: vbal.5.6.9.3, op.add
' SOURCE: spec ms-vbal 5.6.9.3 Arithmetic operators, effective value types involving Single, Double, Currency, Decimal, Date and String
' XFAIL: wrong pending
' EXPECT: Single+Integer=Single
' EXPECT: Byte+Single=Single
' EXPECT: Single+Single=Single
' EXPECT: Single+Long=Double
' EXPECT: Long+Single=Double
' EXPECT: Single+LongLong=Double
' EXPECT: Single+Double=Double
' EXPECT: Double+Integer=Double
' EXPECT: Integer+Double=Double
' EXPECT: Currency+Integer=Currency
' EXPECT: Integer+Currency=Currency
' EXPECT: Currency+Double=Currency
' EXPECT: Currency+Single=Currency
' EXPECT: Currency+Currency=Currency
' EXPECT: Decimal+Byte=Decimal
' EXPECT: Integer+Decimal=Decimal
' EXPECT: Date+Long=Date
' EXPECT: Long+Date=Date
' EXPECT: Date+Date=Date
' EXPECT: Date-Date=Double
' EXPECT: Date-Long=Date
' EXPECT: String+Long=Double
' EXPECT: Long+String=Double
' EXPECT: String+String=String
' EXPECT: strsum=7
' EXPECT: strcat=34
Public Sub Main()
    Dim y As Byte: y = 1
    Dim i As Integer: i = 1
    Dim l As Long: l = 1
    Dim q As LongLong: q = 1
    Dim s As Single: s = 1
    Dim d As Double: d = 1
    Dim c As Currency: c = 1
    Dim dec As Variant: dec = CDec(1)
    Dim dt As Date: dt = 2
    Dim dt2 As Date: dt2 = 5
    Dim t As String: t = "3"
    Dim u As String: u = "4"
    Debug.Print "Single+Integer=" & TypeName(s + i)
    Debug.Print "Byte+Single=" & TypeName(y + s)
    Debug.Print "Single+Single=" & TypeName(s + s)
    Debug.Print "Single+Long=" & TypeName(s + l)
    Debug.Print "Long+Single=" & TypeName(l + s)
    Debug.Print "Single+LongLong=" & TypeName(s + q)
    Debug.Print "Single+Double=" & TypeName(s + d)
    Debug.Print "Double+Integer=" & TypeName(d + i)
    Debug.Print "Integer+Double=" & TypeName(i + d)
    Debug.Print "Currency+Integer=" & TypeName(c + i)
    Debug.Print "Integer+Currency=" & TypeName(i + c)
    Debug.Print "Currency+Double=" & TypeName(c + d)
    Debug.Print "Currency+Single=" & TypeName(c + s)
    Debug.Print "Currency+Currency=" & TypeName(c + c)
    Debug.Print "Decimal+Byte=" & TypeName(dec + y)
    Debug.Print "Integer+Decimal=" & TypeName(i + dec)
    Debug.Print "Date+Long=" & TypeName(dt + l)
    Debug.Print "Long+Date=" & TypeName(l + dt)
    Debug.Print "Date+Date=" & TypeName(dt + dt2)
    Debug.Print "Date-Date=" & TypeName(dt2 - dt)
    Debug.Print "Date-Long=" & TypeName(dt - l)
    Debug.Print "String+Long=" & TypeName(t + l)
    Debug.Print "Long+String=" & TypeName(l + t)
    Debug.Print "String+String=" & TypeName(t + u)
    Debug.Print "strsum=" & CStr(t + u * 1)
    Debug.Print "strcat=" & (t + u)
End Sub
